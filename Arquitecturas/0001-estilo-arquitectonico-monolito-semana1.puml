@startuml 0001-estilo-arquitectonico-monolito-semana1

allowmixing

skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

title Diagrama de Clases y Paquetes - Monolito en Capas (Semana 1)

package "PkgPresentacion" {
    class DiscriminadorDispositivo <<controller>>
    class ControladorPC <<controller>>
    class ControladorTablet <<controller>>
    class ControladorAdminRedaccion <<controller>>
    class MotorPlantillasHTML <<boundary>>
}

package "PkgNegocio" {
    class ServicioNoticias <<service>>
    class ServicioSuscripciones <<service>>
    class ServicioFacturacion <<service>>
    class ServicioEstadisticas <<service>>
}

package "PkgDatos" {
    class AdminPersistenceGateway <<dao>>
    class SubscriberPersistenceGateway <<dao>>
}

database "PostgreSQL 19\n(Admin / Redacción)" as DB_Admin
database "PostgreSQL 19\n(Suscriptores)" as DB_Subs

cloud "Servicios Externos" {
    class "Pasarela Stripe API" as StripeAPI <<external>>
}

' Flujo en Presentación
DiscriminadorDispositivo --> ControladorPC : peticiones PC (User-Agent)
DiscriminadorDispositivo --> ControladorTablet : peticiones Tablet (User-Agent)

ControladorPC --> MotorPlantillasHTML : solicita renderizado vista
ControladorTablet --> MotorPlantillasHTML : solicita renderizado vista
ControladorAdminRedaccion --> MotorPlantillasHTML : solicita renderizado panel

' Presentación -> Negocio
ControladorPC --> ServicioNoticias : consultar noticias
ControladorPC --> ServicioSuscripciones : gestionar suscripción

ControladorTablet --> ServicioNoticias : consultar noticias
ControladorTablet --> ServicioSuscripciones : gestionar suscripción

ControladorAdminRedaccion --> ServicioNoticias : publicar noticias
ControladorAdminRedaccion --> ServicioEstadisticas : consultar métricas de uso

' Negocio interno
ServicioSuscripciones --> ServicioFacturacion : tramitar cobro de cuota

' Negocio -> Datos
ServicioNoticias --> AdminPersistenceGateway
ServicioEstadisticas --> AdminPersistenceGateway

ServicioSuscripciones --> SubscriberPersistenceGateway
ServicioFacturacion --> SubscriberPersistenceGateway

' Datos -> Bases de datos
AdminPersistenceGateway --> DB_Admin : operaciones SQL
SubscriberPersistenceGateway --> DB_Subs : operaciones SQL

' Negocio -> Servicios Externos
ServicioFacturacion ..> StripeAPI : cobro y reintentos (máx 3)

@enduml
